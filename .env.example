# Copy to .env and fill in. NEVER paste these values into a chat or commit .env.
# Check what's set (without revealing values): python bot.py check

# --- Meta / WhatsApp (developers.facebook.com -> your app -> WhatsApp -> API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# A password YOU invent; paste the same value in Meta -> Configure Webhooks -> Verify token
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret. Lets the bot reject requests not signed by Meta.
WHATSAPP_APP_SECRET=
GRAPH_VERSION=v25.0

# --- Claude (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best tone) | claude-sonnet-5-5 (balanced) | claude-haiku-5-5 (cheapest)
CLAUDE_MODEL=claude-opus-5-5
# Cost routing: auto = start chats on the cheap model, escalate to CLAUDE_MODEL for bookings,
# leads, complaints, photos; off = always CLAUDE_MODEL. Compare with: python tests/persona_test.py
ROUTING=off
CLAUDE_MODEL_FAST=claude-haiku-5-5

# --- Owner ---
# Your own WhatsApp number with country code, digits only (e.g. 919812345678).
# Gets handover / payment alerts if you've messaged the bot in the last 24 h.
OWNER_PHONE=
# Daily summary to OWNER_PHONE at this time (HH:MM, business timezone). Empty = off.
OWNER_SUMMARY_TIME=

# --- Payments: demo | manual | razorpay ---
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Server ---
PORT=8000
# DATA_DIR=/data   # set on hosts with a persistent disk mounted somewhere else

# --- Limits (optional) ---
# RATE_LIMIT_MESSAGES=20
# RATE_LIMIT_WINDOW_MIN=10
# HISTORY_MAX_MESSAGES=60
# HOLD_MINUTES=10
# HANDOVER_PAUSE_HOURS=12
